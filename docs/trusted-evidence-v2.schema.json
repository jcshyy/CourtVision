        "knownPossessionFrames": {
          "type": "integer",
          "minimum": 0
        },
        "unknownPossessionFrames": {
          "type": "integer",
          "minimum": 0
        },
        "calibratedFrameCount": {
          "type": "integer",
          "minimum": 0
        },
        "calibrationCoverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
