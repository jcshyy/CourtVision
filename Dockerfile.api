FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app
COPY backend/api-requirements.txt /app/backend/api-requirements.txt
RUN python -m pip install --no-cache-dir -r /app/backend/api-requirements.txt

COPY backend /app/backend

EXPOSE 8080
CMD ["gunicorn", "--bind=0.0.0.0:8080", "--workers=2", "--threads=4", "--timeout=30", "--access-logfile=-", "--error-logfile=-", "backend.app.flask_api:app"]
